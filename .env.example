# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wellness_crm_dev?schema=public"

# Supabase Authentication
# Get these from: Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# API URL (Next.js API routes — no separate backend needed)
NEXT_PUBLIC_API_URL=/api

# JWT Secret (for API authentication)
JWT_SECRET=your_jwt_secret_here_min_32_characters

# Node Environment
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Optional: Logging
LOG_LEVEL=info

# External API Feature Flags (set to 'true' to enable each integration)
# Enable one at a time and test before enabling the next
ENABLE_STRIPE=false
ENABLE_DAILY=false
ENABLE_TWILIO=false
ENABLE_OPENAI=false

# Stage 5: Stripe Payments (requires ENABLE_STRIPE=true)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Stage 7: AI & Smart Features (requires ENABLE_OPENAI=true)
# OpenAI Configuration
OPENAI_API_KEY=sk-xxxxx # Get from https://platform.openai.com/api-keys
OPENAI_MODEL=gpt-4-turbo-preview # Options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo

# Anthropic Claude Configuration (Optional)
ANTHROPIC_API_KEY=sk-ant-xxxxx # Get from https://console.anthropic.com/
ANTHROPIC_MODEL=claude-3-opus-20240229 # Options: claude-3-opus-20240229, claude-3-sonnet-20240229

# AI Provider Settings
AI_PROVIDER=openai # Options: openai, claude, auto
AI_MAX_TOKENS=2000 # Maximum tokens per completion
AI_TEMPERATURE=0.7 # Creativity level (0.0 to 2.0)

# Stage 8: Telehealth Video (requires ENABLE_DAILY=true)
# Daily.co Video Platform (Get API key from https://dashboard.daily.co/)
DAILY_API_KEY=your_daily_api_key_here
DAILY_DOMAIN=your-domain.daily.co

# Stage 4: Communications (requires ENABLE_TWILIO=true)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
SENDGRID_API_KEY=SG.xxxxx
