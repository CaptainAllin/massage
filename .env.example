# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wellness_crm_dev?schema=public"

# Supabase Authentication
# Get these from: Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# API URL (Next.js API routes — no separate backend needed)
NEXT_PUBLIC_API_URL=/api

# JWT Secret (for API authentication)
JWT_SECRET=your_jwt_secret_here_min_32_characters

# Node Environment
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Optional: Logging
LOG_LEVEL=info

# -----------------------------------------------
# Security
# -----------------------------------------------
# AES-256-GCM encryption key for sensitive fields (must be exactly 32 bytes hex = 64 chars)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_key_here

# -----------------------------------------------
# Monitoring & Error Tracking (Sentry)
# -----------------------------------------------
# Get DSN from: Sentry Dashboard -> Project -> Settings -> Client Keys
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@o0.ingest.sentry.io/0
SENTRY_DSN=https://xxxxx@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=wellness-crm
# Get auth token from: Sentry Dashboard -> Settings -> Auth Tokens
SENTRY_AUTH_TOKEN=sntrys_xxxxx

# -----------------------------------------------
# External API Feature Flags (set to 'true' to enable each integration)
# Enable one at a time and test before enabling the next
# -----------------------------------------------
ENABLE_STRIPE=false
ENABLE_DAILY=false
ENABLE_TWILIO=false
ENABLE_OPENAI=false

# Stage 5: Stripe Payments (requires ENABLE_STRIPE=true)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Email — Resend
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Stage 7: AI & Smart Features (requires ENABLE_OPENAI=true)
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-3-opus-20240229
AI_PROVIDER=openai
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# Stage 8: Telehealth Video (requires ENABLE_DAILY=true)
DAILY_API_KEY=your_daily_api_key_here
DAILY_DOMAIN=your-domain.daily.co

# Stage 4: Communications (requires ENABLE_TWILIO=true)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
SENDGRID_API_KEY=SG.xxxxx

# Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxx
VAPID_PRIVATE_KEY=xxxxx
VAPID_EMAIL=mailto:admin@yourdomain.com
FCM_SERVER_KEY=xxxxx

# -----------------------------------------------
# Vercel / CI (only needed for GitHub Actions)
# -----------------------------------------------
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=team_xxxxx
VERCEL_PROJECT_ID=prj_xxxxx
