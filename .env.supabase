# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Replace ALL placeholder values with your actual Supabase credentials
# Get these from: Supabase Dashboard → Project Settings → API

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Anonymous/Public Key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY_HERE

# Supabase Service Role Key (⚠️ SECRET - never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY_HERE

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Get this from: Supabase Dashboard → Project Settings → Database → Connection String (URI)
# Replace [YOUR-PASSWORD] with your database password

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# ============================================
# API URLS
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
API_URL=http://localhost:3001/api/v1

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# ============================================
# INSTRUCTIONS
# ============================================
# 1. Go to https://supabase.com
# 2. Create a new project
# 3. Go to Project Settings → API
# 4. Copy your Project URL and Keys
# 5. Go to Project Settings → Database
# 6. Copy your Connection String
# 7. Replace all placeholder values above
# 8. Rename this file to .env: mv .env.supabase .env
# 9. Continue with SETUP_INSTRUCTIONS.md
