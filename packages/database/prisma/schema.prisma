  @@index([businessId])
  @@index([executedAt])
  @@map("automation_logs")
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  PAID
  CANCELLED
}

model InsuranceProvider {
  id          String           @id @default(cuid())
  businessId  String
  name        String
  payerId     String?
  address     String?
  city        String?
  state       String?
  postalCode  String?
  phone       String?
  fax         String?
  portalUrl   String?
  claimsEmail String?
  notes       String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  claims      InsuranceClaim[]

  @@index([businessId])
  @@index([isActive])
  @@map("insurance_providers")
}

model InsuranceClaim {
  id                       String                  @id @default(cuid())
  businessId               String
  clientId                 String
  appointmentId            String?
  insuranceProviderId      String
  claimNumber              String
  status                   InsuranceClaimStatus    @default(DRAFT)
  submittedAt              DateTime?
  subscriberName           String?
  subscriberDOB            DateTime?
  subscriberPolicyNumber   String?
  groupNumber              String?
  relationshipToSubscriber String?                 @default("SELF")
  diagnosisCodes           Json                    @default("[]")
  procedureCodes           Json                    @default("[]")
  renderingProviderName    String?
  renderingProviderNPI     String?
  billingProviderName      String?
  billingProviderNPI       String?
  billingProviderTaxId     String?
  totalCharge              Float                   @default(0)
  claimedAmount            Float                   @default(0)
  submissionMethod         String?                 @default("ELECTRONIC")
  notes                    String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  business                 Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client                   Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment              Appointment?            @relation(fields: [appointmentId], references: [id])
  insuranceProvider        InsuranceProvider       @relation(fields: [insuranceProviderId], references: [id])
  reimbursements           ClaimReimbursement[]

  @@unique([businessId, claimNumber])
  @@index([businessId])
  @@index([clientId])
  @@index([appointmentId])
  @@index([insuranceProviderId])
  @@index([status])
  @@index([submittedAt])
  @@index([businessId, status])
  @@map("insurance_claims")
}

model ClaimReimbursement {
  id                  String                      @id @default(cuid())
  businessId          String
  claimId             String
  checkNumber         String?
  eobNumber           String?
  paymentDate         DateTime?
  amountBilled        Float                       @default(0)
  amountAllowed       Float                       @default(0)
  amountPaid          Float                       @default(0)
  patientResponsibility Float                     @default(0)
  adjustmentReasons   Json                        @default("[]")
  status              ReimbursementStatus         @default(PENDING)
  notes               String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  business            Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  claim               InsuranceClaim              @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([claimId])
  @@index([status])
  @@index([paymentDate])
  @@map("claim_reimbursements")
}

enum InsuranceClaimStatus {
  DRAFT
  SUBMITTED
  PENDING
  APPROVED
  DENIED
  APPEALING
  PAID
  VOID
}

enum ReimbursementStatus {
  PENDING
  RECEIVED
  RECONCILED
}

model GroupBooking {
  id            String             @id @default(cuid())
  appointmentId String
  clientId      String
  status        GroupBookingStatus @default(REGISTERED)
  paidAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client        Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, clientId])
  @@index([appointmentId])
  @@index([clientId])
  @@map("group_bookings")
}

enum GroupBookingStatus {
  REGISTERED
  ATTENDED
  NO_SHOW
  CANCELLED
}

model Waitlist {
  id             String        @id @default(cuid())
  businessId     String
  clientId       String
  therapistId    String?
  serviceType    String?
  preferredDates Json          @default("[]")
  preferredTimes Json          @default("[]")
  status         WaitlistStatus @default(WAITING)
  offerToken     String?       @unique
  offerExpiresAt DateTime?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  therapist      Therapist?    @relation(fields: [therapistId], references: [id])

  @@index([businessId])
  @@index([clientId])
  @@index([therapistId])
  @@index([status])
  @@index([businessId, status])
  @@index([offerToken])
  @@map("waitlist")
}

enum WaitlistStatus {
  WAITING
  OFFERED
  BOOKED
  EXPIRED
}

enum BookingMode {
  PUBLIC
  EXISTING_CLIENTS_ONLY
  INVITE_ONLY
}

model BookingInvite {
  id         String    @id @default(cuid())
  businessId String
  clientId   String
  token      String    @unique @default(cuid())
  expiresAt  DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([clientId])
  @@index([token])
  @@map("booking_invites")
}

model Room {
  id                String            @id @default(cuid())
  businessId        String
  locationId        String?
  name              String
  color             String?           @default("#8B5CF6")
  capacity          Int?              @default(1)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  business          Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location          Location?         @relation(fields: [locationId], references: [id])
  appointments      Appointment[]
  availabilityRules AvailabilityRule[]

  @@index([businessId])
  @@index([locationId])
  @@index([isActive])
  @@map("rooms")
}

model AvailabilityRule {
  id          String     @id @default(cuid())
  businessId  String
  therapistId String?
  roomId      String?
  serviceType String?
  daysOfWeek  Json
  startTime   String
  endTime     String
  priority    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  therapist   Therapist? @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  room        Room?      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([therapistId])
  @@index([roomId])
  @@map("availability_rules")
}

model AccountingIntegration {
  id             String             @id @default(cuid())
  businessId     String
  provider       AccountingProvider
  status         AccountingStatus   @default(DISCONNECTED)
  accessToken    String?
  refreshToken   String?
  tenantId       String?
  tenantName     String?
  tokenExpiresAt DateTime?
  webhookKey     String?
  lastSyncAt     DateTime?
  syncEnabled    Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  syncLogs       AccountingSyncLog[]

  @@unique([businessId, provider])
  @@index([businessId])
  @@map("accounting_integrations")
}

model AccountingSyncLog {
  id               String             @id @default(cuid())
  integrationId    String
  businessId       String
  entityType       String
  entityId         String
  externalId       String?
  direction        SyncDirection
  status           SyncLogStatus      @default(PENDING)
  errorMessage     String?
  localSnapshot    Json?
  externalSnapshot Json?
  resolvedBy       String?
  resolvedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  integration      AccountingIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([businessId])
  @@index([entityType, entityId])
  @@index([status])
  @@index([createdAt])
  @@map("accounting_sync_logs")
}

enum AccountingProvider {
  XERO
  QUICKBOOKS
}

enum AccountingStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum SyncDirection {
  OUTBOUND
  INBOUND
}

enum SyncLogStatus {
  PENDING
  SUCCESS
  FAILED
  CONFLICT
  RESOLVED
}

model MessageLog {
  id                String           @id @default(cuid())
  businessId        String
  clientId          String?
  appointmentId     String?
  channel           MessageChannel   @default(EMAIL)
  messageType       String
  recipient         String
  subject           String?
  status            MessageLogStatus @default(QUEUED)
  providerMessageId String?
  errorCode         String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  retryCount        Int              @default(0)
  lastRetriedAt     DateTime?
  smsCost           Float?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client            Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([clientId])
  @@index([appointmentId])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@index([businessId, status])
  @@index([businessId, channel])
  @@index([providerMessageId])
  @@map("message_logs")
}

enum MessageChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum MessageLogStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNDELIVERED
}

model Task {
  id                   String       @id @default(cuid())
  businessId           String
  assignedToId         String?
  createdById          String
  title                String
  description          String?
  dueDate              DateTime?
  priority             TaskPriority @default(MEDIUM)
  status               TaskStatus   @default(TODO)
  relatedClientId      String?
  relatedAppointmentId String?
  completedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  business             Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignedTo           User?        @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy            User         @relation("TaskCreator", fields: [createdById], references: [id])
  relatedClient        Client?      @relation(fields: [relatedClientId], references: [id])
  relatedAppointment   Appointment? @relation(fields: [relatedAppointmentId], references: [id])

  @@index([businessId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([businessId, status])
  @@index([businessId, assignedToId])
  @@map("tasks")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum DraftNoteVisibility {
  ONLY_AUTHOR
  ALL_THERAPISTS
  BUSINESS_OWNER_ONLY
}

enum TreatmentNoteStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model ApiKey {
  id          String    @id @default(cuid())
  businessId  String
  name        String
  keyHash     String    @unique
  permissions Json      @default("[]")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([keyHash])
  @@map("api_keys")
}

model Webhook {
  id              String            @id @default(cuid())
  businessId      String
  url             String
  events          Json              @default("[]")
  secret          String
  isActive        Boolean           @default(true)
  lastTriggeredAt DateTime?
  failureCount    Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@index([businessId])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  event        String
  payload      Json
  statusCode   Int?
  responseBody String?
  attemptedAt  DateTime @default(now())
  succeeded    Boolean  @default(false)
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([event])
  @@index([succeeded])
  @@index([attemptedAt])
  @@map("webhook_deliveries")
}
