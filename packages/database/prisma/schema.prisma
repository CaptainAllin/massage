generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(cuid())
  authUserId      String     @unique
  email           String     @unique
  firstName       String?
  lastName        String?
  role            UserRole   @default(CLIENT)
  phoneNumber     String?
  profileImageUrl String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  auditLogs        AuditLog[]
  ownedBusiness    Business?      @relation("BusinessOwner")
  client           Client?
  therapist        Therapist?
  noteTemplates              NoteTemplate[]     @relation("NoteTemplateCreator")
  submittedCommunityTemplates CommunityTemplate[] @relation("CommunityTemplateSubmitter")
  moderatedCommunityTemplates CommunityTemplate[] @relation("CommunityTemplateModerator")
  tasksAssigned    Task[]         @relation("TaskAssignee")
  tasksCreated     Task[]         @relation("TaskCreator")
  notesForReview   TreatmentNote[] @relation("NoteReviewer")

  @@index([email])
  @@index([authUserId])
  @@map("users")
}

model Business {
  id                         String                       @id @default(cuid())
  name                       String
  email                      String?
  phoneNumber                String?
  address                    String?
  city                       String?
  state                      String?
  postalCode                 String?
  country                    String?                      @default("USA")
  website                    String?
  logo                       String?
  primaryColor               String?                      @default("#A8C3A0")
  secondaryColor             String?                      @default("#E7D8C9")
  subscriptionTier           String?                      @default("FREE")
  subscriptionStatus         String?                      @default("ACTIVE")
  smsCreditsIncluded         Int                          @default(50)
  smsCreditsUsed             Int                          @default(0)
  smsBillingCycleStart       DateTime?
  bookingMode                BookingMode                  @default(PUBLIC)
  draftNoteVisibility        DraftNoteVisibility          @default(ALL_THERAPISTS)
  ownerId                    String                       @unique
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  stripeAccountId            String?
  clientPortalEnabled        Boolean                      @default(false)
  clientPortalSettings       Json?
  aiPromptTemplates          AIPromptTemplate[]
  aiUsage                    AIUsage[]
  analyticsSnapshots         AnalyticsSnapshot[]
  appointmentCancellations   AppointmentCancellation[]
  appointmentReminders       AppointmentReminder[]
  appointments               Appointment[]
  auditLogs                  AuditLog[]
  bodyMaps                   BodyMap[]
  owner                      User                         @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  clients                    Client[]
  communicationSettings      CommunicationSettings?
  conversations              Conversation[]
  exportHistory              ExportHistory[]
  giftCards                  GiftCard[]
  giftCardRedemptions        GiftCardRedemption[]
  intakeFormTemplates        IntakeFormTemplate[]
  intakeForms                IntakeForm[]
  automationLogs             AutomationLog[]
  automationRules            AutomationRule[]
  insuranceProviders         InsuranceProvider[]
  insuranceClaims            InsuranceClaim[]
  claimReimbursements        ClaimReimbursement[]
  inventoryAdjustments       InventoryAdjustment[]
  invoices                   Invoice[]
  locations                  Location[]
  loyaltyAccounts            LoyaltyAccount[]
  loyaltySettings            LoyaltySettings?
  loyaltyTransactions        LoyaltyTransaction[]
  medicalConditions          MedicalCondition[]
  membershipSessions         MembershipSession[]
  memberships                Membership[]
  messageTemplates           MessageTemplate[]
  messages                   Message[]
  noteTemplates              NoteTemplate[]
  communityTemplates         CommunityTemplate[]
  packagePurchases           PackagePurchase[]
  packageSessions            PackageSession[]
  payments                   Payment[]
  payrollPeriods             PayrollPeriod[]
  payrollRecords             PayrollRecord[]
  products                   Product[]
  promotions                 Promotion[]
  recurringAppointmentSeries RecurringAppointmentSeries[]
  savedReports               SavedReport[]
  stripeCustomers            StripeCustomer[]
  savedPaymentMethods        SavedPaymentMethod[]
  therapistAvailability      TherapistAvailability[]
  therapistNotes             TherapistNote[]
  therapistTimeOff           TherapistTimeOff[]
  therapists                 Therapist[]
  treatmentNotes             TreatmentNote[]
  videoSessions              VideoSession[]
  voiceNotes                 VoiceNote[]
  waitlist                   Waitlist[]
  bookingInvites             BookingInvite[]
  rooms                      Room[]
  availabilityRules          AvailabilityRule[]
  messageLogs                MessageLog[]
  accountingIntegrations     AccountingIntegration[]
  accountingSyncLogs         AccountingSyncLog[]
  tasks                      Task[]
  scheduledExports           ScheduledExport[]
  apiKeys                    ApiKey[]
  webhooks                   Webhook[]

  @@index([ownerId])
  @@map("businesses")
}

model Therapist {
  id                         String                       @id @default(cuid())
  userId                     String                       @unique
  businessId                 String
  locationId                 String?
  specializations            String[]                     @default([])
  bio                        String?
  licenseNumber              String?
  licenseExpiry              DateTime?
  hourlyRate                 Float?
  isActive                   Boolean                      @default(true)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  appointments               Appointment[]
  preferredClients           Client[]                     @relation("PreferredClients")
  recurringAppointmentSeries RecurringAppointmentSeries[]
  availability               TherapistAvailability[]
  therapistNotes             TherapistNote[]
  timeOff                    TherapistTimeOff[]
  business                   Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location                   Location?                    @relation(fields: [locationId], references: [id])
  user                       User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  treatmentNotes             TreatmentNote[]
  videoSessions              VideoSession[]
  voiceNotes                 VoiceNote[]
  payrollRecords             PayrollRecord[]
  waitlist                   Waitlist[]
  availabilityRules          AvailabilityRule[]
  therapistLocations         TherapistLocation[]

  @@index([userId])
  @@index([businessId])
  @@index([locationId])
  @@index([isActive])
  @@map("therapists")
}

model TherapistLocation {
  id          String    @id @default(cuid())
  therapistId String
  locationId  String
  createdAt   DateTime  @default(now())
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  location    Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([therapistId, locationId])
  @@index([therapistId])
  @@index([locationId])
  @@map("therapist_locations")
}

model Client {
  id                         String                       @id @default(cuid())
  businessId                 String
  locationId                 String?
  userId                     String?                      @unique
  firstName                  String
  lastName                   String
  email                      String?
  phoneNumber                String?
  dateOfBirth                DateTime?
  address                    String?
  city                       String?
  state                      String?
  postalCode                 String?
  emergencyContactName       String?
  emergencyContactPhone      String?
  medicalHistory             Json?
  allergies                  String[]                     @default([])
  medications                String[]                     @default([])
  primaryPhysician           String?
  insuranceProvider          String?
  insurancePolicyNumber      String?
  occupation                 String?
  goals                      String?
  preferredTherapistId       String?
  lastVisitDate              DateTime?
  totalVisits                Int                          @default(0)
  isActive                   Boolean                      @default(true)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  appointments               Appointment[]
  bodyMaps                   BodyMap[]
  business                   Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location                   Location?                    @relation(fields: [locationId], references: [id])
  preferredTherapist         Therapist?                   @relation("PreferredClients", fields: [preferredTherapistId], references: [id])
  user                       User?                        @relation(fields: [userId], references: [id])
  conversations              Conversation[]
  giftCardsPurchased         GiftCard[]
  intakeForms                IntakeForm[]
  invoices                   Invoice[]
  loyaltyAccounts            LoyaltyAccount[]
  medicalConditions          MedicalCondition[]
  memberships                Membership[]
  packagePurchases           PackagePurchase[]
  payments                   Payment[]
  promotionRecipients        PromotionRecipient[]
  recurringAppointmentSeries RecurringAppointmentSeries[]
  stripeCustomers            StripeCustomer[]
  savedPaymentMethods        SavedPaymentMethod[]
  therapistNotes             TherapistNote[]
  treatmentNotes             TreatmentNote[]
  videoSessions              VideoSession[]
  voiceNotes                 VoiceNote[]
  insuranceClaims            InsuranceClaim[]
  groupBookings              GroupBooking[]
  waitlist                   Waitlist[]
  bookingInvites             BookingInvite[]
  messageLogs                MessageLog[]
  relatedTasks               Task[]

  @@index([businessId])
  @@index([locationId])
  @@index([userId])
  @@index([email])
  @@index([phoneNumber])
  @@index([isActive])
  @@index([preferredTherapistId])
  @@index([lastVisitDate])
  @@index([createdAt])
  @@index([businessId, createdAt])
  @@index([businessId, isActive])
  @@index([businessId, lastVisitDate])
  @@map("clients")
}

model Appointment {
  id                String                      @id @default(cuid())
  businessId        String
  clientId          String
  therapistId       String
  locationId        String?
  roomId            String?
  startTime         DateTime
  endTime           DateTime
  status            AppointmentStatus           @default(SCHEDULED)
  serviceType       String?
  duration          Int
  price             Float?
  notes             String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  recurringSeriesId String?
  isVirtual         Boolean                     @default(false)
  isGroup           Boolean                     @default(false)
  capacity          Int?
  cancellation      AppointmentCancellation?
  reminders         AppointmentReminder[]
  groupBookings     GroupBooking[]
  business          Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client            Client                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  location          Location?                   @relation(fields: [locationId], references: [id])
  room              Room?                       @relation(fields: [roomId], references: [id])
  recurringSeries   RecurringAppointmentSeries? @relation(fields: [recurringSeriesId], references: [id])
  therapist         Therapist                   @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  bodyMaps          BodyMap[]
  membershipSession MembershipSession?
  packageSession    PackageSession?
  payments          Payment[]
  treatmentNotes    TreatmentNote[]
  videoSession      VideoSession?
  voiceNotes        VoiceNote[]
  insuranceClaims   InsuranceClaim[]
  relatedTasks      Task[]

  @@index([businessId])
  @@index([clientId])
  @@index([therapistId])
  @@index([locationId])
  @@index([roomId])
  @@index([recurringSeriesId])
  @@index([startTime])
  @@index([status])
  @@index([businessId, startTime])
  @@index([businessId, status])
  @@index([businessId, therapistId, startTime])
  @@map("appointments")
}

model IntakeForm {
  id          String              @id @default(cuid())
  businessId  String
  clientId    String
  templateId  String?
  formData    Json
  submittedAt DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template    IntakeFormTemplate? @relation(fields: [templateId], references: [id])

  @@index([businessId])
  @@index([clientId])
  @@index([templateId])
  @@index([submittedAt])
  @@map("intake_forms")
}

model TreatmentNote {
  id                    String              @id @default(cuid())
  businessId            String
  appointmentId         String
  clientId              String
  therapistId           String
  status                TreatmentNoteStatus @default(DRAFT)
  subjectiveFindings    String?
  objectiveFindings     String?
  assessment            String?
  plan                  String?
  areasWorked           String[]            @default([])
  techniques            String[]            @default([])
  sessionDuration       Int?
  followUpDate          DateTime?
  aiSummary             String?
  noteTemplateId        String?
  noteTemplateName      String?
  reviewerId            String?
  reviewComment         String?
  reviewedAt            DateTime?
  submittedForReviewAt  DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  bodyMaps              BodyMap[]
  appointment           Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  business              Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client                Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  therapist             Therapist   @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  reviewer              User?       @relation("NoteReviewer", fields: [reviewerId], references: [id])
  voiceNotes            VoiceNote[]

  @@index([businessId])
  @@index([appointmentId])
  @@index([clientId])
  @@index([therapistId])
  @@index([followUpDate])
  @@index([businessId, createdAt])
  @@index([businessId, therapistId])
  @@map("treatment_notes")
}

model IntakeFormTemplate {
  id          String       @id @default(cuid())
  businessId  String
  name        String
  description String?
  fields      Json
  isActive    Boolean      @default(true)
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  intakeForms IntakeForm[]

  @@index([businessId])
  @@index([isActive])
  @@index([isDefault])
  @@map("intake_form_templates")
}

model NoteTemplate {
  id         String    @id @default(cuid())
  businessId String?
  name       String
  category   String
  fields     Json
  isGlobal   Boolean   @default(false)
  isArchived Boolean   @default(false)
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creator    User?     @relation("NoteTemplateCreator", fields: [createdBy], references: [id])

  @@index([businessId])
  @@index([isGlobal])
  @@index([category])
  @@map("note_templates")
}

model CommunityTemplate {
  id                    String                  @id @default(cuid())
  name                  String
  category              String
  fields                Json
  description           String?
  status                CommunityTemplateStatus @default(PENDING)
  usageCount            Int                     @default(0)
  submittedByUserId     String
  submittedByBusinessId String?
  rejectionReason       String?
  moderatedBy           String?
  moderatedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  submittedByUser     User      @relation("CommunityTemplateSubmitter", fields: [submittedByUserId], references: [id])
  submittedByBusiness Business? @relation(fields: [submittedByBusinessId], references: [id], onDelete: SetNull)
  moderator           User?     @relation("CommunityTemplateModerator", fields: [moderatedBy], references: [id])

  @@index([status])
  @@index([category])
  @@index([submittedByUserId])
  @@map("community_templates")
}

enum CommunityTemplateStatus {
  PENDING
  APPROVED
  REJECTED
}

model BodyMap {
  id              String         @id @default(cuid())
  businessId      String
  clientId        String
  appointmentId   String?
  treatmentNoteId String?
  view            String
  regions         Json
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  appointment     Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  treatmentNote   TreatmentNote? @relation(fields: [treatmentNoteId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([clientId])
  @@index([appointmentId])
  @@index([treatmentNoteId])
  @@index([createdAt])
  @@map("body_maps")
}

model TherapistNote {
  id          String    @id @default(cuid())
  businessId  String
  clientId    String
  therapistId String
  content     String
  isPinned    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([clientId])
  @@index([therapistId])
  @@index([isPinned])
  @@index([createdAt])
  @@map("therapist_notes")
}

model MedicalCondition {
  id            String    @id @default(cuid())
  businessId    String
  clientId      String
  name          String
  diagnosisDate DateTime?
  status        String    @default("active")
  severity      String?
  notes         String?
  treatmentPlan String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@map("medical_conditions")
}

model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  businessId String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([businessId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

model TherapistAvailability {
  id          String    @id @default(cuid())
  businessId  String
  therapistId String
  dayOfWeek   Int
  startTime   String
  endTime     String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([therapistId])
  @@index([dayOfWeek])
  @@index([isActive])
  @@map("therapist_availability")
}

model TherapistTimeOff {
  id          String    @id @default(cuid())
  businessId  String
  therapistId String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  isAllDay    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([therapistId])
  @@index([startDate])
  @@index([endDate])
  @@map("therapist_time_off")
}

model AppointmentCancellation {
  id               String      @id @default(cuid())
  appointmentId    String      @unique
  businessId       String
  cancelledBy      String
  reason           String?
  cancellationType String
  cancelledAt      DateTime    @default(now())
  appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  business         Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([appointmentId])
  @@index([cancelledBy])
  @@index([cancelledAt])
  @@map("appointment_cancellations")
}

model RecurringAppointmentSeries {
  id           String        @id @default(cuid())
  businessId   String
  clientId     String
  therapistId  String
  frequency    String
  interval     Int           @default(1)
  dayOfWeek    Int?
  dayOfMonth   Int?
  daysOfWeek   Json?
  startTime    String
  duration     Int
  startDate    DateTime
  endDate      DateTime?
  occurrences  Int?
  serviceType  String?
  price        Float?
  notes        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  therapist    Therapist     @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([clientId])
  @@index([therapistId])
  @@index([isActive])
  @@index([startDate])
  @@map("recurring_appointment_series")
}

model AppointmentReminder {
  id            String      @id @default(cuid())
  appointmentId String
  businessId    String
  reminderType  String
  scheduledFor  DateTime
  status        String      @default("PENDING")
  sentAt        DateTime?
  failureReason String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([appointmentId])
  @@index([scheduledFor])
  @@index([status])
  @@index([businessId, status, scheduledFor])
  @@map("appointment_reminders")
}

model Message {
  id             String        @id @default(cuid())
  businessId     String
  conversationId String?
  senderId       String?
  senderType     String
  recipientId    String
  recipientType  String
  type           String
  subject        String?
  content        String
  status         String        @default("PENDING")
  direction      String
  externalId     String?
  externalStatus String?
  failureReason  String?
  metadata       Json?
  scheduledFor   DateTime?
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  @@index([businessId])
  @@index([conversationId])
  @@index([senderId])
  @@index([recipientId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([scheduledFor])
  @@map("messages")
}

model Conversation {
  id                 String    @id @default(cuid())
  businessId         String
  clientId           String
  type               String
  subject            String?
  status             String    @default("ACTIVE")
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages           Message[]

  @@index([businessId])
  @@index([clientId])
  @@index([type])
  @@index([status])
  @@index([lastMessageAt])
  @@map("conversations")
}

model MessageTemplate {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  type        String
  category    String?
  subject     String?
  content     String
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([type])
  @@index([category])
  @@index([isActive])
  @@map("message_templates")
}

model CommunicationSettings {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  twilioAccountSid      String?
  twilioAuthToken       String?
  twilioPhoneNumber     String?
  sendGridApiKey        String?
  sendGridFromEmail     String?
  sendGridFromName      String?
  whatsappPhoneNumberId String?
  whatsappAccessToken   String?
  smsEnabled            Boolean  @default(false)
  emailEnabled          Boolean  @default(false)
  whatsappEnabled       Boolean  @default(false)
  defaultReminderHours  Int      @default(24)
  autoSendReminders     Boolean  @default(false)
  emailSignature        String?
  smsOverageEnabled     Boolean  @default(false)
  smsHardStop           Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("communication_settings")
}

model StripeCustomer {
  id               String   @id @default(cuid())
  businessId       String
  clientId         String
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([businessId, clientId])
  @@index([businessId])
  @@index([clientId])
  @@map("stripe_customers")
}

model SavedPaymentMethod {
  id                    String   @id @default(cuid())
  businessId            String
  clientId              String
  stripePaymentMethodId String   @unique
