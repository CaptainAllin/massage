# Test environment variables
# Override DATABASE_URL here to use a separate test database (recommended for CI)
# DATABASE_URL=postgresql://...test_db...

NODE_ENV=test
ENABLE_STRIPE=false

# Supabase (values don't matter in tests — Supabase auth is mocked)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=test-anon-key
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key

# Resend (mocked in tests)
RESEND_API_KEY=test-resend-key
RESEND_FROM_EMAIL=test@example.com

# Stripe (disabled in tests via ENABLE_STRIPE=false)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
