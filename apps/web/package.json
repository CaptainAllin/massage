{
  "name": "@massage/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next .turbo node_modules",
    "test": "jest --testPathPattern='__tests__'",
    "test:integration": "jest --testPathPattern='__tests__/integration'",
    "test:security": "jest --testPathPattern='__tests__/security'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@massage/auth": "*",
    "@massage/types": "*",
    "@massage/ui": "*",
    "@sentry/nextjs": "^10.53.1",
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.6.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.0",
    "@tanstack/react-query": "^5.17.19",
    "@types/web-push": "^3.6.4",
    "axios": "^1.6.5",
    "lucide-react": "^0.316.0",
    "next": "^14.2.20",
    "next-pwa": "^5.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@massage/config-eslint": "*",
    "@massage/config-tailwind": "*",
    "@massage/config-typescript": "*",
    "@playwright/test": "^1.60.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.20",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  }
